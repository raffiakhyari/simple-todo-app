
pipeline {
    agent any

    parameters {
        string(
            name: 'IMAGE_REPO',
            defaultValue: '',
            description: 'Docker image repository dari CI'
        )
        string(
            name: 'IMAGE_TAG',
            defaultValue: '',
            description: 'Build number/tag image dari CI'
        )
    }

    options {
        timestamps()
        disableConcurrentBuilds()

        buildDiscarder(
            logRotator(numToKeepStr: '10')
        )
    }

    environment {
        // SSH host key harus sudah terdaftar di known_hosts
        SSH_OPTIONS = '-o BatchMode=yes -o StrictHostKeyChecking=yes -o ConnectTimeout=15'
    }

    stages {

        // ==========================================
        // 1. Validate Parameters
        // ==========================================

        stage('Validate Parameters') {
            steps {
                script {
                    if (!(env.BRANCH_NAME in ['develop', 'main'])) {
                        error("Unsupported branch: ${env.BRANCH_NAME}")
                    }

                    if (!params.IMAGE_REPO?.trim() ||
                        !params.IMAGE_TAG?.trim()) {
                        error('IMAGE_REPO and IMAGE_TAG are required')
                    }

                    // Hanya izinkan repository Docker Hub yang diharapkan.
                    def allowedRepos = [
                        develop: 'raffiakhyari/todo-api-dev',
                        main:    'raffiakhyari/todo-api'
                    ]

                    if (params.IMAGE_REPO != allowedRepos[env.BRANCH_NAME]) {
                        error(
                            "Image repository does not match branch " +
                            "${env.BRANCH_NAME}"
                        )
                    }

                    // Mencegah nilai parameter disisipkan sebagai shell command.
                    if (!(params.IMAGE_TAG ==~ /[0-9]+/)) {
                        error("Invalid image tag: ${params.IMAGE_TAG}")
                    }

                    env.DEPLOY_IMAGE =
                        "${params.IMAGE_REPO}:${params.IMAGE_TAG}"

                    echo """
                    ==========================================
                    DEPLOYMENT PARAMETERS
                    ==========================================
                    Branch : ${env.BRANCH_NAME}
                    Image  : ${env.DEPLOY_IMAGE}
                    ==========================================
                    """
                }
            }
        }

        // ==========================================
        // 2. Select Environment
        // ==========================================

        stage('Select Environment') {
            steps {
                script {
                    if (env.BRANCH_NAME == 'develop') {
                        env.DEPLOY_ENV = 'DEV'
                        env.DEPLOY_HOST = 'YOUR_DEV_VM_IP'
                        env.DEPLOY_USER = 'ubuntu'
                        env.DEPLOY_DIR = '/opt/todo-api'
                        env.SSH_CREDENTIALS = 'todo-api-dev-ssh'
                    } else {
                        env.DEPLOY_ENV = 'PROD'
                        env.DEPLOY_HOST = 'YOUR_PROD_VM_IP'
                        env.DEPLOY_USER = 'ubuntu'
                        env.DEPLOY_DIR = '/opt/todo-api'
                        env.SSH_CREDENTIALS = 'todo-api-prod-ssh'
                    }

                    echo """
                    ==========================================
                    DEPLOYMENT TARGET
                    ==========================================
                    Environment : ${env.DEPLOY_ENV}
                    Host        : ${env.DEPLOY_HOST}
                    Directory   : ${env.DEPLOY_DIR}
                    Image       : ${env.DEPLOY_IMAGE}
                    ==========================================
                    """
                }
            }
        }

        // ==========================================
        // 3. Verify SSH Connection
        // ==========================================

        stage('SSH Connection') {
            steps {
                sshagent(credentials: [env.SSH_CREDENTIALS]) {
                    sh '''
                        set -eu

                        ssh ${SSH_OPTIONS} \
                            "${DEPLOY_USER}@${DEPLOY_HOST}" \
                            'echo "SSH connection successful"'
                    '''
                }
            }
        }

        // ==========================================
        // 4. Deploy with Docker Compose
        // ==========================================

        stage('Deploy') {
            steps {
                sshagent(credentials: [env.SSH_CREDENTIALS]) {
                    sh '''
                        set -eu

                        echo "=========================================="
                        echo "Deploying ${DEPLOY_IMAGE}"
                        echo "Environment: ${DEPLOY_ENV}"
                        echo "=========================================="

                        ssh ${SSH_OPTIONS} \
                            "${DEPLOY_USER}@${DEPLOY_HOST}" \
                            "cd '${DEPLOY_DIR}' && \
                            export IMAGE_REPO='${IMAGE_REPO}' && \
                            export IMAGE_TAG='${IMAGE_TAG}' && \
                            echo 'Pulling image: ${DEPLOY_IMAGE}' && \
                            docker compose config --quiet && \
                            docker compose pull && \
                            docker compose up -d --remove-orphans && \
                            docker compose ps"

                        echo "Deployment command completed."
                    '''
                }
            }
        }

        // ==========================================
        // 5. Verify Deployment
        // ==========================================

        stage('Verify Deployment') {
            steps {
                sshagent(credentials: [env.SSH_CREDENTIALS]) {
                    sh '''
                        set -eu

                        ssh ${SSH_OPTIONS} \
                            "${DEPLOY_USER}@${DEPLOY_HOST}" \
                            "cd '${DEPLOY_DIR}' && \
                            docker compose ps --all"

                        echo "=========================================="
                        echo "Deployment verification completed."
                        echo "=========================================="
                    '''
                }
            }
        }
    }

    post {
        success {
            echo """
            ==========================================
            CD SUCCESS
            ==========================================
            Application : todo-api
            Environment : ${env.DEPLOY_ENV}
            Branch      : ${env.BRANCH_NAME}
            Image       : ${env.DEPLOY_IMAGE}
            CI Tag      : ${params.IMAGE_TAG}
            ==========================================
            """
        }

        failure {
            echo """
            ==========================================
            CD FAILED
            ==========================================
            Branch : ${env.BRANCH_NAME}
            Image  : ${params.IMAGE_REPO}:${params.IMAGE_TAG}

            Check SSH, Docker Compose, image access,
            and the remote container logs.
            ==========================================
            """
        }
    }
}
